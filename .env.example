# SQLite database file (relative to project root)
DATABASE_URL="file:./dev.db"

# Public base URL of the app
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Razorpay TEST mode credentials (https://dashboard.razorpay.com -> Settings -> API Keys)
# Leave empty to run in "Demo payment mode unavailable" state — previews,
# rejections and audit trail still work without keys.
RAZORPAY_KEY_ID="rzp_test_xxxxxxxxx"
RAZORPAY_KEY_SECRET="xxxxxxxxxxxxxxxxxxxx"

# OpenAI-compatible LLM for intent parsing ONLY (optional).
# Leave empty to use the deterministic local fallback parser ("AI fallback mode").
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-4o-mini"

# Secret used to verify Razorpay server-to-server webhooks
# (Dashboard -> Settings -> Webhooks). Optional for local dev.
RAZORPAY_WEBHOOK_SECRET=""

# LLM: any OpenAI-compatible endpoint (OpenAI, OpenRouter, Groq, DeepSeek, Ollama...).
OPENAI_BASE_URL="https://openrouter.ai/api/v1"
