// AgentPay — Prisma schema (SQLite)
//
// NOTE ON ENUMS: SQLite does not support native enums in Prisma.
// `status` and `actor` are stored as strings and validated with Zod
// schemas in src/schemas/*.ts which act as the single source of truth.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model CatalogItem {
  id               String    @id @default(cuid())
  sku              String    @unique
  name             String
  description      String
  pricePaise       Int
  currency         String    @default("INR")
  stock            Int
  active           Boolean   @default(true)
  imageUrl         String?
  // Agent access controls (Commerce Control Plane)
  agentDiscoverable Boolean  @default(true)
  agentPurchasable  Boolean  @default(true)
  paused            Boolean  @default(false)
  maxAgentQuantity  Int?
  availableFrom     DateTime?
  availableUntil    DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  checkoutItems CheckoutItem[]

  @@index([active])
}

/// Versioned merchant AI-commerce policy. Each save creates a new immutable
/// row; the highest policyVersion is authoritative. Historical checkouts are
/// never re-evaluated against newer versions.
model MerchantPolicy {
  id                              String    @id @default(cuid())
  policyVersion                   Int       @unique
  merchantName                    String
  // Transaction controls
  maxOrderPaise                   Int
  maxQuantityPerItem              Int       @default(5)
  maxItemsPerOrder                Int
  confirmationRequired            Boolean   @default(true)
  allowedCurrency                 String    @default("INR")
  sessionExpiryMinutes            Int       @default(30)
  // Budget controls
  defaultBuyerBudgetPaise         Int?
  maxAgentProposedCartPaise       Int       @default(200000)
  extraConfirmationThresholdPaise Int       @default(75000)
  dailyTestModeCapPaise           Int       @default(500000)
  // Agent authority controls
  agentCanRecommend               Boolean   @default(true)
  agentCanPrepareCheckout         Boolean   @default(true)
  agentCanApplyBundleDiscount     Boolean   @default(false)
  // Risk controls
  maxAttemptsPerSession           Int       @default(3)
  maxCheckoutsPerCartHash         Int       @default(5)
  coolingOffMinutesAfterFailures  Int       @default(10)
  lowStockReviewThreshold         Int       @default(2)
  // Recovery controls
  recoveryEnabled                 Boolean   @default(true)
  maxRecoveryAttempts             Int       @default(2)
  changedBy                       String    @default("Merchant Demo Admin")
  changeNote                      String?
  createdAt                       DateTime  @default(now())
  supersededAt                    DateTime?

  @@index([createdAt])
}

/// Bounded revenue-recovery case linked to exactly one checkout session.
model RecoveryCase {
  id                        String    @id @default(cuid())
  checkoutSessionId         String    @unique
  status                    String    @default("ELIGIBLE")
  interventionType          String
  reasonCodes               Json
  expectedRecoveryValuePaise Int
  actualRecoveredValuePaise Int?
  attemptCount              Int       @default(0)
  nextEligibleAt            DateTime?
  stoppedReason             String?
  policyVersion             Int
  replacementSessionId      String?
  createdAt                 DateTime  @default(now())
  updatedAt                 DateTime  @updatedAt

  session CheckoutSession  @relation(fields: [checkoutSessionId], references: [id], onDelete: Cascade)
  actions RecoveryAction[]

  @@index([status])
  @@index([nextEligibleAt])
  @@index([createdAt])
}

/// Merchant-approved simulated recovery action (no real messaging).
model RecoveryAction {
  id             String    @id @default(cuid())
  recoveryCaseId String
  actionType     String
  messagePreview String
  copyMode       String    @default("template")
  copyVersion    String    @default("v1")
  approvedBy     String
  executedAt     DateTime?
  result         String
  metadata       Json
  createdAt      DateTime  @default(now())

  recoveryCase RecoveryCase @relation(fields: [recoveryCaseId], references: [id], onDelete: Cascade)

  @@index([recoveryCaseId])
}

model CheckoutSession {
  id                String   @id @default(cuid())
  cartHash          String
  status            String   @default("DRAFT")
  totalPaise        Int
  currency          String   @default("INR")
  buyerBudgetPaise  Int?
  razorpayOrderId   String?  @unique
  razorpayPaymentId String?  @unique
  razorpaySignature String?
  rejectionReason   String?
  rejectionDetails  Json?
  idempotencyKey    String   @unique
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  items       CheckoutItem[]
  auditEvents AuditEvent[]
  recoveryCase RecoveryCase?

  @@index([cartHash])
  @@index([status])
  @@index([cartHash, status])
  @@index([createdAt])
}

model CheckoutItem {
  id             String @id @default(cuid())
  sessionId      String
  catalogItemId  String
  sku            String
  itemName       String
  unitPricePaise Int
  quantity       Int
  lineTotalPaise Int

  session     CheckoutSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  catalogItem CatalogItem     @relation(fields: [catalogItemId], references: [id], onDelete: Restrict)

  @@index([sessionId])
}

model AuditEvent {
  id           String    @id @default(cuid())
  // Null sessionId = global (merchant-level) chain, e.g. policy changes.
  sessionId    String?
  eventType    String
  actor        String
  payload      Json
  previousHash String?
  eventHash    String
  createdAt    DateTime  @default(now())

  session CheckoutSession? @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([sessionId, createdAt])
  @@index([eventType])
}

model PolicyConfig {
  id                   String   @id @default(cuid())
  maxOrderPaise        Int      @default(100000)
  maxItemsPerOrder     Int      @default(5)
  confirmationRequired Boolean  @default(true)
  merchantName         String
  updatedAt            DateTime @updatedAt
}

/// Server-to-server payment events from Razorpay. The unique eventId makes
/// redeliveries idempotent: the same webhook can never fulfil stock twice.
model WebhookEvent {
  id          String    @id @default(cuid())
  eventId     String    @unique
  eventType   String
  payload     Json
  status      String    @default("RECEIVED")
  receivedAt  DateTime  @default(now())
  processedAt DateTime?

  @@index([eventType])
}
